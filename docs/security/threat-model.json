              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "911badb3-fb26-546f-b96f-33d25829383d",
                  "type": "Spoofing",
                  "title": "JWT fallback арқылы жалған сессия",
                  "description": "JWT_SECRET жоқ ортада auth.ts болжамды fallback қолданады. Құпия кілттің тірі ортада қолданылғаны белгісіз. RAID: R02; SEC-01.",
                  "mitigation": "Fallback жою; startup validation; нақты қолданылған кілтті айналдыру; auth negative tests.",
                  "severity": "High",
                  "status": "Open",
                  "modelType": "STRIDE"
                },
                {
                  "id": "bf093375-8c81-5fea-994f-77af4d0957d2",
                  "type": "Tampering",
                  "title": "Бөгде жоспар күнін өзгерту",
                  "description": "PATCH plan/day body.dayId бойынша жаңартады; JWT мен дерек иесі тексерілмейді. RAID: R01; SEC-01.",
                  "mitigation": "userId token-нен; owner шарты бар query; status enum және транзакция; екі пайдаланушының теріс тесті.",
                  "severity": "High",
                  "status": "Open",
                  "modelType": "STRIDE"
                },
                {
                  "id": "db773cf8-c37c-5c66-b5b7-1fc4bb1a4129",
                  "type": "Repudiation",
                  "title": "Әрекеттің авторын дәлелдеу мүмкін емес",
                  "description": "Арнайы access/consent audit моделі көрінбейді; console.error толық аудиттің орнына жүрмейді. RAID: R15; SEC-03.",
                  "mitigation": "Уақыт, actor pseudonym, action, resource ID, result, correlation ID; өзгертілмейтін сақтау; token/prompt-сыз журнал.",
                  "severity": "Medium",
                  "status": "Open",
                  "modelType": "STRIDE"
                },
                {
                  "id": "25fec6dc-b042-551a-a2b8-d1984281b438",
                  "type": "Information disclosure",
                  "title": "Жоспардың ашылуы және LLM-ге артық мәтін беру",
                  "description": "GET plan/current query.userId-ге сенеді. Training API сыртқы провайдерге соңғы 6 хабарлама мен ағымдағы мәтінді жібереді. RAID: R01, R04; SEC-01 / SEC-03.",
                  "mitigation": "Owner guard; prompt минимизациясы; consent/беру негізі; ҚР сақтау дәлелі; backup шифрлау.",
                  "severity": "High",
                  "status": "Open",
                  "modelType": "STRIDE"
                },
                {
                  "id": "f3bce64e-07b0-5dca-b378-1e0eb6bba818",
                  "type": "Denial of service",
                  "title": "Шектеусіз AI сұрауы ресурсты ұстайды",
                  "description": "Training message route-та timeout, per-user rate limit және message max length анықталмады. RAID: R08, R19; SEC-03.",
                  "mitigation": "Ұзындық шегі, per-user лимит, Abort timeout, квота және retry budget; жүктеме тесті.",
                  "severity": "Medium",
                  "status": "Open",
                  "modelType": "STRIDE"
                },
                {
                  "id": "73ea2fe9-8e87-5845-95a9-97259a82089c",
                  "type": "Elevation of privilege",
                  "title": "Басқа қолданушының дерегін басқару",
                  "description": "Plan және study-activity маршруттары клиент жіберген userId-ді өкілеттік ретінде қабылдайды. Docker процестерінде root default бар. RAID: R01, R12; SEC-01 / SEC-02.",
                  "mitigation": "Object-level authorization және least privilege; контейнерге non-root USER; DB құқығын шектеу.",
                  "severity": "High",
                  "status": "Open",
                  "modelType": "STRIDE"
                }
              ],
              "isWebApplication": true
            }
